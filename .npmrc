# aube's settings. CI's one npm command, the aube bootstrap, runs outside the
# checkout and reads no repository configuration. npm reads this file when nx
# runs a package script.

# Only package.json's `aube.allowBuilds` entries, at their exact versions, run
# dependency install scripts. Any other install script fails the install.
strictDepBuilds=true
useDefaultTrustedDependencies=false

# A different aube fails the install instead of downloading the pinned one.
managePackageManagerVersions=false
packageManagerStrict=error
packageManagerStrictVersion=true

# A version resolved anew must be at least 7 days old. An exception is one
# `name@exact-version` entry of a single comma-separated
# minimumReleaseAgeExclude value, never a bare name or a pattern.
minimumReleaseAge=10080
minimumReleaseAgeStrict=true

# Only an install command installs. `aube run` and `aube exec` don't check the
# tree against package.json and the lockfile, and install nothing. aube reads
# the value as a strict boolean, so it is exactly `true`.
aubeNoAutoInstall=true

node-linker=hoisted
defaultLockfile=package-lock.json
savePrefix=
