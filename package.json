{
  "name": "@ydinjs/material-x-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "debug": "just debug",
    "build": "nx run-many -t build --all --skipNxCache",
    "clean:build": "nx run-many -t clean:build --all --skipNxCache",
    "check": "concurrently npm:fmt:check npm:lint npm:typecheck",
    "test": "vitest run",
    "docs": "just docs-build",
    "docs:dev": "just docs-dev",
    "fmt": "just fmt",
    "fmt:check": "just fmt-check",
    "lint": "concurrently npm:lint:packages",
    "lint:packages": "just lint",
    "lint:fix": "just lint-fix",
    "oxlint:migrate": "just oxlint-migrate",
    "typecheck": "just typecheck",
    "postinstall": "node ./.scripts/link-tsserver.ts"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/config-helpers": "0.7.0",
    "@jridgewell/gen-mapping": "0.3.13",
    "@mdx-js/react": "3.1.1",
    "@minify-html/node": "0.18.1",
    "@mizchi/lsmcp": "0.10.0",
    "@preact/signals-core": "1.14.5",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-links": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-vaadin": "1.0.0-beta.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-oxlint": "1.93.0",
    "just-camel-case": "6.2.0",
    "just-kebab-case": "4.2.0",
    "just-safe-get": "4.2.0",
    "just-safe-set": "4.2.1",
    "lightningcss": "1.33.0",
    "nx": "24.0.6",
    "oxc-transform": "0.158.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.3.2",
    "rust-just": "1.59.0",
    "size-limit": "14.3.0",
    "sorcery": "1.0.0",
    "storybook": "10.6.7",
    "tsdown": "0.23.7",
    "tsgolint": "0.0.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "type-fest": "5.10.0",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-inspect": "12.1.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@mdx-js/react": "$@mdx-js/react",
    "eslint": "$eslint",
    "react": "$react",
    "rolldown": "$rolldown",
    "vite": "$vite"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "rs-module-lexer@2.8.0": true,
    "unrs-resolver@1.11.1": true,
    "esbuild@0.28.1": true,
    "nx@24.0.6": true
  }
}
