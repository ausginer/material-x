{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@ydinjs/drag2",
  "tsconfig": "./tsconfig.json",
  "entryPoints": [
    "./src/drag.ts",
    "./src/kernel.ts",
    "./src/sortable.ts",
    "./src/sortable/feature.ts",
    "./src/sortable/y.ts",
    "./src/sortable/xy.ts",
    "./src/sortable/landing.ts",
    "./src/sortable/layout-animation.ts"
  ],
  "entryPointStrategy": "resolve",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "sort": ["source-order"],
  "intentionallyNotExported": [
    "src/kernel/frames.ts:Frame",
    "src/kernel/frames.ts:Draft",
    "src/kernel/frames.ts:FramePartOf",
    "src/kernel/lifetimes.ts:LifetimeScope",
    "src/kernel/presentation.ts:VisualLiftSession",
    "src/kernel/presentation.ts:LiftMode",
    "src/kernel/seams.ts:Transition",
    "src/kernel/spec.ts:ReleaseTransition",
    "src/kernel/spec.ts:SettlementTransition",
    "src/kernel/spec.ts:ActionTransition",
    "src/kernel/spec.ts:BehaviorInstall",
    "src/kernel/spec.ts:SETTLED_FULFILLED",
    "src/kernel/spec.ts:SETTLED_REJECTED",
    "src/kernel/spec.ts:SETTLED_SKIPPED",
    "src/kernel/spec.ts:SETTLED_CANCELED",
    "src/kernel/spec.ts:SETTLED_FAILED",
    "src/kernel/types.ts:OffsetBox"
  ]
}
