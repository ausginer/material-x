set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
_eslint := "eslint --flag unstable_native_nodejs_ts_config -c eslint.config.ts"

# List available recipes
default:
    @just --list

# Build core. Cleans first, so an output whose entrypoint was deleted cannot
# survive into the next build: `tsdown` overwrites what it emits and removes
# nothing, so an orphaned module stays importable by relative path and keeps a
# stale fixture building (F-157).
build: clean-build
    tsdown --config tsdown.config.ts

# Delete build artefacts
clean-build:
    node ../../.scripts/package-files.ts clean --package .

# Build TypeDoc API into the cache consumed by the Storybook dev server
docs-api-prepare:
    typedoc --options typedoc.json --out ../../node_modules/.cache/docs/api/drag

# Build TypeDoc API into the output directory
docs-api-build:
    typedoc --options typedoc.json --out ../../.docs/api/drag

# Run tests
test *ARGS:
    vitest run -c vitest.config.ts {{ ARGS }}

# Type-check
typecheck:
    tsc -p tsconfig.json --noEmit

# Format files (paths are relative to this package)
fmt *FILES:
    oxfmt {{ if FILES == "" { "." } else { FILES } }}

# Check formatting without writing
fmt-check *FILES:
    oxfmt --check {{ if FILES == "" { "." } else { FILES } }}

# Lint files
lint *FILES:
    oxlint {{ if FILES == "" { "." } else { FILES } }}
    {{ _eslint }} {{ if FILES == "" { "." } else { FILES } }}

# Lint and auto-fix files
lint-fix *FILES:
    oxlint --fix {{ if FILES == "" { "." } else { FILES } }}
    {{ _eslint }} --fix {{ if FILES == "" { "." } else { FILES } }}

# Measure bundle sizes, budgets and module graphs (builds first)
# `--files` writes each measured bundle under `.measured/`; `--unminified`
# writes a readable twin beside it. Neither changes a reported figure.
size *FLAGS: build
    node bench/size/measure.ts {{ FLAGS }}

# Build the profiling fixture as a production bundle, with source maps
# (`bench/profile`). Not a benchmark harness: a page to record in Chrome's
# performance panel. Output lands in the ignored `.vite/profile`.
profile-build:
    vite build -c bench/profile/vite.config.ts

# Build and serve that fixture at http://localhost:4180/ — `vite preview`, so
# what runs is the production bundle and no dev server is in the recording.
profile: profile-build
    vite preview -c bench/profile/vite.config.ts

diff:
  git show HEAD --format= -- .plan > "/workspaces/material-x/docs-$(date +%Y%m%d-%H%M%S).patch"

# Walk this package's cants call graph — `just calls --help` for options
calls *ARGS:
    node ../../.scripts/call-graph.ts {{ ARGS }}
