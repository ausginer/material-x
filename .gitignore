/target
/.idea
/node_modules
/.vite
/.vite-inspect
/.vitest
/.nx
/.coverage
/packages/*/.vite
/packages/*/.coverage
/packages/*/.vitest
/packages/*/node_modules
/packages/*/custom-elements.json
/packages/*/.codeanalyzer

# `just size --files` writes each measured bundle here for reading. Output of a
# measurement, never an input to one.
/packages/*/.measured

# `bench/campaign.ts` writes each run's status and logs here. Raw output that a
# report copies into its record; never an input.
/packages/*/.campaigns
/packages/**/*.js
/packages/**/*.js.map
/packages/**/*.d.ts.map
/packages/**/*.d.ts
/packages/*/.vitest-attachments

# Raw design-system tables, kept only for debugging the token update script.
# They carry personal data, and the store under packages/tproc/tokens/ is what
# is committed.
/packages/tproc/.data/

# **Hand-written ambient declarations, not build output.** Every package builds
# with `outDir: '.'`, so generated `.d.ts` land beside the entrypoints and never
# under `src/` — but the blanket rule above swallowed the authored ones too, and
# `packages/drag/src/globals.d.ts` is the whole `__DEV__` declaration: without
# it a fresh clone cannot typecheck that package at all.
#
# ~~`!/packages/*/src`~~ was the intended fix and is a **no-op**: nothing above
# excludes the `src` directory itself, and git cannot re-include a file by
# re-including a directory that was never excluded. The negation has to name the
# files.
#
# Deliberately `.d.ts` only. `.js`, `.js.map` and `.d.ts.map` under `src/` stay
# ignored, so this admits authored declarations and no emitted artifact.
!/packages/*/src/**/*.d.ts

*storybook.log
storybook-static
.docs
*.css
!*.module.css
!*.styles.css
!*.ctr.css

!.storybook/preview-frame.css

.agents/codex
.claude/worktrees
.codex-attachments
.claude/settings.local.json
*.patch
