{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.migrated.json"],
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/.plan/**/*",
    ".nx/**/*",
    ".vite/**/*",
    ".vite-inspect/**/*",
    ".docs/**/*",
    ".storybook-static/**/*",
    "button/**/*",
    "button-group/**/*",
    "checkbox/**/*",
    "core/**/*",
    "fab/**/*",
    "icon/**/*",
    "radio/**/*",
    "text-field/**/*",
    "attribute.js",
    "attribute.js.map",
    "attribute.d.ts",
    "attribute.d.ts.map",
    "controllers/**/*",
    "element.js",
    "element.js.map",
    "element.d.ts",
    "element.d.ts.map",
    "emitter.js",
    "emitter.js.map",
    "emitter.d.ts",
    "emitter.d.ts.map",
    "traits/**/*",
    "utils/**/*",
    "_virtual/**/*",
    "custom-elements.json",
    "react.d.ts",
    "react.d.ts.map",
    "packages/*/dist/**/*",
    "packages/*/custom-elements.json",
    "packages/material-x/button/**/*",
    "packages/material-x/button-group/**/*",
    "packages/material-x/checkbox/**/*",
    "packages/material-x/fab/**/*",
    "packages/material-x/icon/**/*",
    "packages/material-x/radio/**/*",
    "packages/material-x/text-field/**/*",
    "packages/material-x/core/**/*",
    "packages/material-x/react.d.ts",
    "packages/material-x/react.d.ts.map",
    "packages/ydin/attribute.js",
    "packages/ydin/attribute.js.map",
    "packages/ydin/attribute.d.ts",
    "packages/ydin/attribute.d.ts.map",
    "packages/ydin/controllers/**/*",
    "packages/ydin/element.js",
    "packages/ydin/element.js.map",
    "packages/ydin/element.d.ts",
    "packages/ydin/element.d.ts.map",
    "packages/ydin/emitter.js",
    "packages/ydin/emitter.js.map",
    "packages/ydin/emitter.d.ts",
    "packages/ydin/emitter.d.ts.map",
    "packages/ydin/traits/**/*",
    "packages/ydin/utils/**/*",
    "packages/ydin/_virtual/**/*",
    "packages/material-x/**/*.js",
    "packages/material-x/**/*.js.map",
    "packages/material-x/**/*.d.ts",
    "packages/material-x/**/*.d.ts.map",
    "packages/ydin/**/*.js",
    "packages/ydin/**/*.js.map",
    "packages/ydin/**/*.d.ts",
    "packages/ydin/**/*.d.ts.map"
  ],
  "rules": {
    // The repository's source doesn't meet these two type-aware rules yet:
    // each reports in most packages, and turning one on is a source change of
    // its own. ESLint turns both off in `eslint.config.ts` as rules that oxlint
    // runs, so this is the one place that decides them.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/promise-function-async": "off",
    // ESLint's `@typescript-eslint/unbound-method`, last in
    // `eslint.config.ts`, is the instrument for a method read without a
    // receiver. Oxlint's port also reports a method passed together with its
    // receiver, as in `drag.use(this.#release, this)`, which ESLint accepts.
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      // Custom rules
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "max-params": "allow",
        "import/no-unassigned-import": "allow",
        "typescript/no-empty-object-type": "allow",
        // The type-aware form of `no-empty-object-type`: it reports a type
        // that resolves to `{}` rather than one written as `{}`.
        "typescript/no-generated-empty-object-type": "allow",
        "prefer-default-export": "allow",
        "preserve-caught-error": "allow",
        "no-void": "allow",
        "no-shadow": "allow",
        // Broken. Cannot disable inline
        "import/unambiguous": "allow",
        // Broken. Many false positives
        "typescript/no-unnecessary-condition": "allow",
        // `eslint.base.config.ts` turns off ESLint's forms of these two, so
        // oxlint is the only linter that runs them, and the tree meets both.
        "no-use-before-define": [
          "error",
          {
            "classes": true,
            "functions": true,
            "variables": true,
            "typedefs": true
          }
        ],
        "import/no-duplicates": [
          "error",
          {
            "prefer-inline": true
          }
        ]
      }
    }
  ]
}
